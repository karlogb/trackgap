# TrackGap configuration (copy to .env and fill in).
# The server reads these from the process environment. Alternatively each
# group can live in a JSON file under $TRACKGAP_SECRETS (shopify.json,
# google.json, meta.json, smtp.json); a file wins over env vars.

# --- Public URL of the app (Shopify app URL, OAuth redirects, alert links)
TRACKGAP_APP_URL=https://trackgap.example.com
PORT=9310
NODE_ENV=production

# --- Shopify app (Partner Dashboard > App > Client credentials)
SHOPIFY_API_KEY=your-shopify-client-id
SHOPIFY_API_SECRET=your-shopify-client-secret
# SHOPIFY_SCOPES=read_orders,read_pixels,write_pixels,read_customer_events

# --- Google OAuth client (GA4 Data API + Admin API, read-only scope)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Meta app (optional; merchants can also paste an Events Manager token)
META_APP_ID=
META_APP_SECRET=

# --- Outgoing mail for alerts (any SMTP server with STARTTLS + AUTH)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change-me
TRACKGAP_MAIL_FROM=TrackGap <alerts@example.com>
TRACKGAP_MAIL_REPLYTO=support@example.com
# TRACKGAP_SMTP_CONFIG=/path/to/smtp.json   # alternative to SMTP_* above

# --- Storage
# Directory for the SQLite DB and the AES-256-GCM key (.enc_key, generated on
# first start). Default: ./data next to app/.
# TRACKGAP_DATA=./data
# TRACKGAP_DB=./data/trackgap.db
# TRACKGAP_SECRETS=./.secrets

# --- Tuning (defaults shown)
# TRACKGAP_MIN_AGE_HOURS=0        # minimum order age before comparing with GA4
# TRACKGAP_ACCESS_GRACE_H=6       # hours of lost API access before alerting
# TRACKGAP_DAILY_HOUR=7           # local hour for the daily scheduled check
# TRACKGAP_ADS_MIN_SPEND=1        # min campaign spend to report "no conversions"
# TRACKGAP_BILLING_TEST=1         # create Shopify test charges

# --- Development only (ignored when NODE_ENV=production)
# TRACKGAP_DEV_SHOP=your-dev-store.myshopify.com
